~~ arithmetic, precedence, and negation ~~
splash 1 + 2 * 3;
splash (1 + 2) * 3;
splash -7 / 2;
splash 17 % 5;
splash 3 < 4;
splash 3 >= 4;

~~ stashing, shadowing, and reassignment ~~
stash pebbles = 10;
pebbles = pebbles + 5;
splash pebbles;
if 1 {
  stash pebbles = 99;
  splash pebbles;
}
splash pebbles;

~~ else-if chains ~~
dive classify(pebble n) -> pebble {
  if n < 0 { surface -1; }
  else if n == 0 { surface 0; }
  else { surface 1; }
}
splash classify(-5);
splash classify(0);
splash classify(42);

~~ dives can call dives defined later, and fall off the end with 0 ~~
dive quiet() -> pebble { stash x = helper(2, 3); }
dive helper(pebble a, pebble b) -> pebble { surface a * b; }
splash quiet();
splash helper(6, 7);

~~ nested paddles ~~
stash total = 0;
paddle i from 0 to 4 {
  paddle j from 0 to i {
    total = total + 1;
  }
}
splash total;
